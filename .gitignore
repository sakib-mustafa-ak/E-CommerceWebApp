# ==============================================================================
# Monorepo .gitignore for Siam's Aqua E-Commerce (Turborepo + pnpm)
# Covers apps/api (NestJS), apps/web (Next.js), apps/mobile (Expo), and packages/
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnp
.pnp.js

# Note: pnpm-lock.yaml is intentionally NOT ignored and must be committed.

# ------------------------------------------------------------------------------
# Build & Output Artifacts
# ------------------------------------------------------------------------------
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Mobile (React Native / Expo)
.expo/
.expo-shared/
web-build/

# Native build folders generated by Expo prebuild / Gradle / Xcode
apps/mobile/android/
apps/mobile/ios/
*.orig.*

# ------------------------------------------------------------------------------
# Environment Variables & Secret Keys
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Certificate & Private Key files
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Note: .env.example files must NEVER be ignored (they serve as templates)
!.env.example
!apps/**/.env.example
!packages/**/.env.example

# ------------------------------------------------------------------------------
# Uploaded & Temporary Local Storage (Prescriptions, Licenses, Temp files)
# ------------------------------------------------------------------------------
uploads/
**/uploads/*
!**/uploads/.gitkeep
tmp/
**/tmp/*
!**/tmp/.gitkeep
scratch/

# ------------------------------------------------------------------------------
# Databases & Local Data Directories
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.db
*.db-journal
*.db-shm
*.db-wal
postgres-data/
pgdata/

# Prisma: prisma/schema.prisma & migrations/ ARE COMMITTED.
# Ignore generated Prisma output if placed outside node_modules:
src/generated/
generated/

# ------------------------------------------------------------------------------
# Logs & Diagnostic Dumps
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# ------------------------------------------------------------------------------
# Editor & OS Noise
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
