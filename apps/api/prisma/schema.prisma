generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  phone                String?           @unique
  passwordHash         String
  name                 String
  accountType          String            // SUPER_ADMIN, STAFF, PAIKARI_SELLER, WHOLESALER_SELLER, MPO, FOOD_VENDOR, PUBLIC_USER
  is2FAEnabled         Boolean           @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?           // JSON array of hashed recovery codes
  suspensionType       String            @default("NONE") // NONE, INDEFINITE, TEMPORARY
  suspendedUntil       DateTime?
  suspensionReason     String?
  failedLoginAttempts  Int               @default(0)
  lockoutUntil         DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  staffProfile         StaffProfile?
  customerProfile      CustomerProfile?
  userRoles            UserRole[]
  manualOverrides      CustomerManualOverrideRate[]
  orders               Order[]
  returnRequests       ReturnRequest[]
  preOrders            PreOrder[]
  stockBatches         StockBatch[]
  stockSales           StockSaleRecord[]
  mpoProfile           MpoProfile?
  mpoBids              MpoBid[]
  reviews              Review[]
  wishlist             Wishlist[]
  digitalTokens        DigitalDownloadToken[]
  behaviorLogs         UserBehaviorLog[]
  wholesalerPublicListings WholesalerPublicListing[]
  resellerLedgerEntries ResellerCommissionLedgerEntry[]
  resellerStatements   ResellerMonthlyStatement[]
  gameOrders           GameTopUpOrder[]
  auditLogs            AuditLog[]
}

model StaffProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  department   String?
  employeeCode String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Role {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              String           @id @default(uuid())
  slug            String           @unique
  name            String
  category        String           // orders, pricing, accounts, catalog, security, system, returns
  description     String?

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model CustomerProfile {
  id                   String       @id @default(uuid())
  userId               String       @unique
  shopName             String
  ownerName            String
  address              String
  tradeLicenseNo       String?
  drugLicenseNo        String?
  tradeLicenseFileUrl  String?
  drugLicenseFileUrl   String?
  tierId               String
  creditLimit          Float        @default(0)
  codLimit             Float        @default(0)
  deliveryFeeThreshold Float        @default(0)
  runningTabBalance    Float        @default(0) // Future-proof Rule 8
  
  // Phase 1 Problem Customer & Ranking metrics
  cancellationCount    Int          @default(0)
  refusalCount         Int          @default(0)
  isProblemCustomer    Boolean      @default(false)
  problemFlagReason    String?
  totalMonthlySales    Float        @default(0)

  // Phase 2 Returns store credit & running returns metrics
  creditBalance        Float        @default(0) // Running customer store credit / tab balance for next memo
  totalReturnsCount    Int          @default(0)
  totalReturnsValue    Float        @default(0)
  
  // Phase 3 Wholesale Category Access Control
  allowedCategories    String?      @default("ALL") // "ALL" or JSON array of allowed category strings
  
  // Phase 4 Stock Management Access Control (Granted explicitly by Admin)
  hasStockModuleAccess Boolean      @default(false)
  
  // Phase 7 Wholesalers Selling to the Public
  isPublicResellerEnabled Boolean      @default(false)
  resellerCommissionRate  Float        @default(2.0) // Commission % added on top (e.g. 2.0%)
  resellerDefaultBranding String       @default("WHITE_LABEL") // WHITE_LABEL, WHOLESALER_BRAND
  totalResellerSalesCount Int          @default(0)
  totalResellerGrossVolume Float       @default(0)
  totalResellerCommissionEarned Float  @default(0)
  totalResellerNetOwed    Float        @default(0)

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 PricingTier  @relation(fields: [tierId], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model ApplicationQueue {
  id                  String   @id @default(uuid())
  businessName        String
  ownerName           String
  phone               String
  email               String
  address             String
  accountType         String   // PAIKARI_SELLER, WHOLESALER_SELLER, FOOD_VENDOR
  categoryInterest    String?
  tradeLicenseNo      String?
  drugLicenseNo       String?
  tradeLicenseFileUrl String?
  drugLicenseFileUrl  String?
  status              String   @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  reviewNote          String?
  reviewedBy          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PricingTier {
  id              String            @id @default(uuid())
  code            String            @unique // TIER_A, TIER_B, TIER_C, etc.
  name            String
  description     String?
  defaultRateType String            @default("PERCENTAGE") // PERCENTAGE, FLAT_RATE
  defaultValue    Float             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customerProfiles CustomerProfile[]
  companyRates     CompanyRate[]
  productOverrides ProductOverrideRate[]
}

model Company {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  products     Product[]
  companyRates CompanyRate[]
  mpoCompanies MpoCompany[]
}

// MedEx-Style Normalized Generic Entity
model Generic {
  id                String    @id @default(uuid())
  name              String    @unique // e.g. "Paracetamol", "Omeprazole", "Azithromycin"
  slug              String    @unique
  therapeuticClass  String?   // e.g. "Analgesics & Antipyretics", "Proton Pump Inhibitors"
  description       String?
  indications       String?   // Structured indications info
  dosageGuidelines  String?   // General dosage recommendations
  sideEffects       String?   // Common side effects
  precautions       String?   // Warnings & contraindications
  pregnancyCategory String?   // e.g. "A", "B", "C", "D", "X"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  products          Product[]
}

// MedEx-Style Medicine Product Entity with returnability flags
model Product {
  id                      String                @id @default(uuid())
  name                    String                // Brand Name: e.g. "Napa Extra", "Ace Plus"
  slug                    String                @unique
  genericId               String?
  genericName             String                // Denormalized generic tag for fast querying: e.g. "Paracetamol + Caffeine"
  companyId               String
  dosageForm              String                @default("Tablet") // Tablet, Syrup, Capsule, Injection, Suspension, Drop
  strength                String                @default("500mg")  // e.g. "500 mg", "665 mg", "120 mg/5 ml", "20 mg"
  mrp                     Float                 // Retail reference price in BDT
  unit                    String                @default("Strip (10 tabs)")
  packSize                String?               // e.g. "10 x 10's", "100 ml Bottle", "1 Vial"
  category                String                @default("Allopathic") // Allopathic, Herbal, Surgical, OTC
  description             String?
  isPrescriptionRequired  Boolean               @default(false)

  // Phase 2 Returns fields
  isReturnable            Boolean               @default(true)
  returnCount             Int                   @default(0)
  isHighReturnRate        Boolean               @default(false)
  highReturnFlagReason    String?

  // Phase 3 Wholesale MOQ
  wholesaleMoq            Int                   @default(1)

  // Two separate inventories rule (Rule 4) & Phase 4 Offer Para Live Marketplace
  isOfferParaLiveStock    Boolean               @default(false)
  offerParaStockQty       Int                   @default(0)
  offerParaDisplayMode    String                @default("EXACT_COUNT") // EXACT_COUNT, IN_STOCK_ONLY
  offerParaDiscountTiers  String?               // JSON array: [{"minQty":5,"discountPercent":20},{"minQty":10,"discountPercent":25}]
  isPharmaTrackOpaque     Boolean               @default(true) // External PharmaTrack opaque stock

  // Future proofing (Rule 8)
  serviceBookingAvailable Boolean               @default(false)
  counterSaleEnabled      Boolean               @default(false)

  // Phase 6: Public Market, Product Types & B2C Features
  productType             String                @default("PHYSICAL") // PHYSICAL, DIGITAL, SERVICE
  isCodAvailable          Boolean               @default(true)       // Per-product COD toggle
  digitalFileUrl          String?
  digitalDownloadLimit    Int                   @default(5)
  digitalExpiryHours      Int                   @default(48)
  quantityDiscountTiers   String?               // JSON: [{"minQty":5,"discountPercent":5},{"minQty":10,"discountPercent":8}]
  variantsJson            String?               // JSON: [{"name":"Small","price":100},{"name":"Large","price":200}]
  averageRating           Float                 @default(0)
  totalReviewsCount       Int                   @default(0)

  generic                 Generic?              @relation(fields: [genericId], references: [id])
  company                 Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productOverrides        ProductOverrideRate[]
  manualOverrides         CustomerManualOverrideRate[]
  orderItems              OrderItem[]
  returnItems             ReturnItem[]
  preOrders               PreOrder[]
  stockBatches            StockBatch[]
  stockSaleItems          StockSaleItem[]
  mpoSelections           MpoProductSelection[]
  mpoListings             MpoListing[]
  reviews                 Review[]
  wishlistItems           Wishlist[]
  digitalTokens           DigitalDownloadToken[]
  wholesalerPublicListings WholesalerPublicListing[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([genericName])
  @@index([name])
  @@index([dosageForm])
  @@index([companyId])
  @@index([productType])
}

// Staging Pipeline for Medicine Bulk Imports (No Blind Imports)
model MedicineStagingBatch {
  id            String                @id @default(uuid())
  batchNumber   String                @unique
  fileName      String
  totalRows     Int
  validRows     Int                   @default(0)
  duplicateRows Int                   @default(0)
  errorRows     Int                   @default(0)
  status        String                @default("STAGED") // STAGED, REVIEWING, PUBLISHED, REJECTED
  importedBy    String
  publishedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  items         MedicineStagingItem[]
}

model MedicineStagingItem {
  id                String               @id @default(uuid())
  batchId           String
  brandName         String
  genericName       String
  companyName       String
  dosageForm        String
  strength          String
  mrp               Float
  unit              String               @default("Strip (10 tabs)")
  packSize          String?
  category          String               @default("Allopathic")
  indications       String?
  therapeuticClass  String?
  isDuplicate       Boolean              @default(false)
  existingProductId String?
  validationErrors  String?              // JSON array of validation issues
  status            String               @default("PENDING") // PENDING, APPROVED, REJECTED, PUBLISHED

  batch             MedicineStagingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt         DateTime             @default(now())
}

model CompanyRate {
  id        String      @id @default(uuid())
  companyId String
  tierId    String
  rateType  String      @default("PERCENTAGE") // PERCENTAGE, FLAT_RATE
  value     Float
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tier      PricingTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([companyId, tierId])
}

model ProductOverrideRate {
  id        String      @id @default(uuid())
  productId String
  tierId    String
  rateType  String      @default("PERCENTAGE") // PERCENTAGE, FLAT_RATE
  value     Float
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  tier      PricingTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([productId, tierId])
}

model CustomerManualOverrideRate {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rateType  String   @default("PERCENTAGE") // PERCENTAGE, FLAT_RATE
  value     Float
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Order {
  id                      String          @id @default(uuid())
  orderNumber             String          @unique
  sectorType              String          @default("PHARMACY") // PHARMACY, WHOLESALE, OFFER_PARA, FOOD, etc.
  platformStatus          String          @default("DRAFT_SALE") // DRAFT_SALE, COMPLETE_SALE, CANCELLED, RETURNED (Rule 3)
  fulfillmentStatus       String          @default("PENDING") // PENDING, VERIFYING, PACKED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, REFUSED_DELIVERY
  
  // Memo states & totals
  memoState               String          @default("PRELIMINARY_MRP") // PRELIMINARY_MRP, FINAL_TIERED
  isFinalMemoPublished    Boolean         @default(false)
  preliminarySubtotal     Float           @default(0)
  finalSubtotal           Float           @default(0)
  subtotal                Float           @default(0)
  discountAmount          Float           @default(0)
  deliveryFee             Float           @default(0)
  totalAmount             Float           @default(0)
  
  // Fulfillment & Logistics
  fulfillmentMethod       String          @default("HOME_DELIVERY") // SELF_PICKUP, SEND_SOMEONE, HOME_DELIVERY
  pickupPersonName        String?
  pickupPersonPhone       String?
  deliveryAddress         String
  isTodayDelivery         Boolean         @default(true)
  isCod                   Boolean         @default(true)
  
  // Payment
  paymentMethod           String          @default("COD") // COD, BKASH, BANK_TRANSFER, ADVANCE
  paymentStatus           String          @default("UNPAID") // UNPAID, PAID, ADVANCE_PAID
  
  // Staff concurrency & presence (Rule 6)
  lastUpdatedByStaff      String?
  lastUpdatedByStaffName  String?
  
  // Cancellation handling (3 states)
  cancellationState       String          @default("NONE") // NONE, REQUESTED, APPROVED, REJECTED, REFUSED_AT_DELIVERY
  cancellationReason      String?
  cancellationRequestedAt DateTime?

  // Phase 2 Returns receipt tracking
  confirmedReceiptAt      DateTime?
  
  // Media & Notes
  orderNotes              String?
  voiceNoteUrl            String?
  isPrescriptionReq       Boolean         @default(false)
  prescriptionUrl         String?
  placedByStaffId         String?         // For orders placed on behalf of customer
  placedByStaffName       String?
  
  // Future proofing fields (Rule 8) & Phase 5 Pre-Order Draft Memos
  isCounterSale           Boolean         @default(false)
  isPreOrderDraft         Boolean         @default(false)
  preOrderSupplyStatus    String?         // PENDING_ARRIVAL, PARTIALLY_ARRIVED, CANCELLED_UNFULFILLED, FULFILLED

  // Phase 6: Public Market, Guest Checkout & Digital Assets
  isGuestOrder            Boolean         @default(false)
  guestName               String?
  guestEmail              String?
  guestPhone              String?
  orderType               String          @default("PHYSICAL") // PHYSICAL, DIGITAL, SERVICE
  advanceDepositRequired  Float           @default(0)
  advanceDepositPaid      Float           @default(0)
  deliveryTrackingCode    String?
  courierPartner          String?

  userId                  String?
  user                    User?           @relation(fields: [userId], references: [id])
  items                   OrderItem[]
  returnRequests          ReturnRequest[]
  digitalTokens           DigitalDownloadToken[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([userId])
  @@index([fulfillmentStatus])
  @@index([memoState])
  @@index([orderType])
}

model OrderItem {
  id                         String    @id @default(uuid())
  orderId                    String
  productId                  String
  unitType                   String    @default("STRIP") // PIECE, STRIP, BOX
  variant                    String?   // Size/Color/Flavor variant
  requestedQuantity          Int
  confirmedQuantity          Int       @default(0)
  actualReceivedQuantity     Int?      // For Pre-Order arrivals syncing
  isBonusItem                Boolean   @default(false)
  bonusRatio                 String?   // e.g. "10+2"
  
  // Verification states (Full / Partial / None)
  verificationStatus         String    @default("PENDING") // PENDING, FULL_STOCK, PARTIAL_STOCK, NONE_AVAILABLE
  isOfferPara                Boolean   @default(false)
  
  // Pricing breakdown
  unitMrp                    Float
  tieredUnitPrice            Float     @default(0)
  finalUnitPrice             Float     @default(0)
  manualPriceOverrideByStaff Float?
  appliedUnitPrice           Float     @default(0)
  appliedLayer               String    @default("TIER_DEFAULT") // CUSTOMER_MANUAL_OVERRIDE, PRODUCT_OVERRIDE, COMPANY_RATE, TIER_DEFAULT
  rateType                   String    @default("PERCENTAGE")
  rateValue                  Float     @default(0)
  totalPrice                 Float     @default(0)
  
  // Concurrency field per line item (Rule 6)
  fulfilledByStaffId         String?
  fulfilledByStaffName       String?
  fulfilledAt                DateTime?

  // Phase 7 Wholesaler Reselling fields
  wholesalerPublicListingId  String?
  resellerWholesalerId       String?
  wholesalerBasePrice        Float?
  platformCommissionAmount   Float?

  order                      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                    Product   @relation(fields: [productId], references: [id])
  resellerListing            WholesalerPublicListing? @relation(fields: [wholesalerPublicListingId], references: [id])
}

// Case-by-case manual return judgment request (Phase 2)
model ReturnRequest {
  id                  String       @id @default(uuid())
  returnNumber        String       @unique // RET-2026-00001
  orderId             String
  userId              String
  sectorType          String       @default("PHARMACY") // PHARMACY, PUBLIC, WHOLESALE
  status              String       @default("PENDING") // PENDING, APPROVED, REJECTED
  totalRefundCredit   Float        @default(0)
  reason              String
  voiceNoteUrl        String?
  reviewedByStaffId   String?
  reviewedByStaffName String?
  reviewedAt          DateTime?
  reviewNotes         String?

  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user                User         @relation(fields: [userId], references: [id])
  items               ReturnItem[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

// Line items in a return request (supports partial returns)
model ReturnItem {
  id                        String        @id @default(uuid())
  returnRequestId           String
  orderItemId               String
  productId                 String
  productName               String
  genericName               String
  unitType                  String        @default("STRIP")
  originalUnitPrice         Float
  originalPurchasedQuantity Int
  returnedQuantity          Int
  refundCreditAmount        Float
  isOfferParaStock          Boolean       @default(false)
  stockReversed             Boolean       @default(false)

  returnRequest             ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  product                   Product       @relation(fields: [productId], references: [id])
}

model PharmaTrackShortList {
  id                  String   @id @default(uuid())
  orderId             String?
  orderNumber         String?
  productId           String
  productName         String
  genericName         String
  companyName         String
  requestedQuantity   Int
  unitType            String   @default("STRIP")
  shopId              String
  shopName            String
  shopPhone           String?
  reportedByStaffId   String?
  reportedByStaffName String?
  status              String   @default("OPEN") // OPEN, ORDERED, RESOLVED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([genericName])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "problem_customer_threshold", "default_free_delivery_threshold", "bank_account_info", "return_window_days", "high_return_product_threshold"
  value       String   // JSON or string
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model IpRule {
  id        String    @id @default(uuid())
  ipAddress String    @unique
  type      String    @default("BLOCK") // ALLOW, BLOCK
  reason    String
  expiresAt DateTime?
  createdBy String?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String   // TIER_CHANGED, MANUAL_RATE_CHANGED, etc.
  entityType String
  entityId   String
  beforeData String?  // JSON string
  afterData  String?  // JSON string
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [actorId], references: [id])
}

model BackupRecord {
  id              String    @id @default(uuid())
  fileName        String
  fileSizeBytes   Int
  checksum        String
  storageLocation String
  status          String    @default("SUCCESS")
  drillVerifiedAt DateTime?
  drillNotes      String?
  createdAt       DateTime  @default(now())
}

// Phase 3: Wholesale Pre-Orders Model (with lead-time & demand routing)
model PreOrder {
  id                  String    @id @default(uuid())
  preOrderNumber      String    @unique // PRE-2026-00001
  userId              String
  productId           String
  requestedQuantity   Int
  unitType            String    @default("BOX")
  leadTimeDays        Int       @default(3) // 2, 3, 4, 5 days
  targetPrice         Float?
  status              String    @default("PENDING") // PENDING, SOURCING, CONFIRMED, FULFILLED, CANCELLED
  notes               String?
  mpoAssignedId       String?
  reviewedByStaffId   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             Product   @relation(fields: [productId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([leadTimeDays])
}

// Phase 4: Stock Management Module Models (Multi-Tenant Inventory & Profit Tracking)
model StockBatch {
  id                  String          @id @default(uuid())
  batchNumber         String          // e.g. BAT-2026-0001
  productId           String
  ownerId             String          // Admin for Offer Para / Wholesaler for individual resale store
  initialQuantity     Int
  currentQuantity     Int
  purchaseCost        Float           // Purchase cost per unit in BDT
  sellingPrice        Float           // Standard retail sale price
  wholesalePrice      Float           // Wholesale rate for bulk resales
  mfgDate             DateTime?
  expiryDate          DateTime        // Expiry alert trigger
  supplierName        String?
  lowStockThreshold   Int             @default(10)
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  owner               User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  saleItems           StockSaleItem[]

  @@index([ownerId])
  @@index([productId])
  @@index([expiryDate])
}

model StockSaleRecord {
  id                  String          @id @default(uuid())
  receiptNumber       String          @unique // REC-2026-0001
  ownerId             String
  saleType            String          @default("RETAIL") // RETAIL, WHOLESALE, COUNTER_OFFLINE
  customerName        String?
  customerPhone       String?
  subtotal            Float           @default(0)
  discountPercent     Float           @default(0) // 5, 8, 10
  discountAmount      Float           @default(0)
  totalAmount         Float           @default(0)
  totalCost           Float           @default(0)
  profitMargin        Float           @default(0) // totalAmount - totalCost
  paymentMethod       String          @default("CASH") // CASH, BKASH, CARD, TAB
  notes               String?
  createdAt           DateTime        @default(now())

  owner               User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items               StockSaleItem[]

  @@index([ownerId])
  @@index([createdAt])
}

model StockSaleItem {
  id                  String          @id @default(uuid())
  saleRecordId        String
  batchId             String?
  productId           String
  productName         String
  quantity            Int
  unitCost            Float
  unitPrice           Float
  totalPrice          Float
  profit              Float

  saleRecord          StockSaleRecord @relation(fields: [saleRecordId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id])
  batch               StockBatch?     @relation(fields: [batchId], references: [id])

  @@index([saleRecordId])
  @@index([productId])
}

// Phase 5: MPO Market, Anonymity Engine & Wholesaler Bidding Models
model MpoProfile {
  id                   String                @id @default(uuid())
  userId               String                @unique
  territory            String                // e.g., "Dhaka South", "Chittagong Central"
  anonymousLabel       String                // e.g., "Anonymous 1 (Siam's Aqua Store)"
  photoUrl             String?
  assignedCompanies    MpoCompany[]
  productSelections    MpoProductSelection[]
  listings             MpoListing[]
  totalSubmissions     Int                   @default(0)
  totalSalesCount      Int                   @default(0)
  totalSalesVolume     Float                 @default(0)
  adminPrivateNotes    String?
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([territory])
}

model MpoCompany {
  id           String      @id @default(uuid())
  mpoProfileId String
  companyId    String
  mpoProfile   MpoProfile  @relation(fields: [mpoProfileId], references: [id], onDelete: Cascade)
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([mpoProfileId, companyId])
}

model MpoProductSelection {
  id           String      @id @default(uuid())
  mpoProfileId String
  productId    String
  mpoProfile   MpoProfile  @relation(fields: [mpoProfileId], references: [id], onDelete: Cascade)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([mpoProfileId, productId])
}

model MpoListing {
  id                      String      @id @default(uuid())
  listingNumber           String      @unique // e.g. MPO-2026-0001
  mpoProfileId            String
  productId               String
  offeredQuantity         Int
  bonusQuantity           Int         @default(0) // Free items (e.g., 2 in 10+2)
  bonusRatio              String?     // e.g., "10+2", "20+5"
  mpoTargetPrice          Float       // MPO's expected net unit price
  unitMrp                 Float
  status                  String      @default("PENDING_ADMIN_REVIEW") // PENDING_ADMIN_REVIEW, APPROVED, REJECTED, BID_ACCEPTED, FULFILLED, STALE
  rejectionReason         String?
  adminApprovedAt         DateTime?
  adminApprovedBy         String?
  staleNudgeSentAt        DateTime?

  // Channel Visibility Matrix & Channel-Specific Pricing set by Admin
  isVisiblePublic         Boolean     @default(false)
  isVisiblePaikari        Boolean     @default(false)
  isVisibleWholesale      Boolean     @default(false)
  publicUnitPrice         Float?
  paikariUnitPrice        Float?
  wholesaleUnitPrice      Float?

  bids                    MpoBid[]
  mpoProfile              MpoProfile  @relation(fields: [mpoProfileId], references: [id], onDelete: Cascade)
  product                 Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([status])
  @@index([mpoProfileId])
  @@index([productId])
}

model MpoBid {
  id              String      @id @default(uuid())
  listingId       String
  wholesalerId    String      // User ID of wholesaler
  bidUnitPrice    Float
  bidQuantity     Int
  status          String      @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  mpoListing      MpoListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  wholesaler      User        @relation(fields: [wholesalerId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([listingId])
  @@index([wholesalerId])
}

// Phase 6: Public Market, Customer Reviews, Wishlist, Digital Tokens & Behavioral Logging
model Review {
  id                 String    @id @default(uuid())
  productId          String
  userId             String?
  guestName          String?
  rating             Int       @default(5) // 1 to 5
  comment            String
  videoUrl           String?
  imageUrl           String?
  isVerifiedPurchase Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([rating])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model DigitalDownloadToken {
  id            String    @id @default(uuid())
  token         String    @unique // Secure random token
  orderId       String
  productId     String
  userId        String?
  guestEmail    String?
  downloadCount Int       @default(0)
  maxDownloads  Int       @default(5)
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([orderId])
  @@index([productId])
}

model UserBehaviorLog {
  id             String    @id @default(uuid())
  userId         String?
  guestSessionId String?
  eventType      String    // PRODUCT_VIEWED, PRODUCT_ADDED_TO_CART, PRODUCT_PURCHASED, SEARCH_PERFORMED
  productId      String?
  metadata       String?   // JSON object with additional parameters
  createdAt      DateTime  @default(now())

  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([guestSessionId])
  @@index([eventType])
  @@index([productId])
  @@index([createdAt])
}

// Phase 7: Wholesaler Reselling in Public Market
model WholesalerPublicListing {
  id                    String      @id @default(uuid())
  wholesalerId          String
  productId             String
  wholesalerBasePrice   Float       // Wholesaler net requested price (e.g. 500 BDT)
  commissionRate        Float       @default(2.0) // Platform commission % (e.g. 2.0%)
  commissionAmount      Float       // e.g. 10 BDT
  calculatedPublicPrice Float       // e.g. 510 BDT
  stockQuantity         Int         @default(0) // Available inventory listed for public sale
  brandingMode          String      @default("WHITE_LABEL") // WHITE_LABEL, WHOLESALER_BRAND
  status                String      @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED, PAUSED
  reviewNotes           String?
  reviewedByStaffId     String?
  reviewedAt            DateTime?
  totalSoldUnits        Int         @default(0)
  totalGrossSales       Float       @default(0)
  totalCommissionPaid   Float       @default(0)
  isSuspended           Boolean     @default(false)
  suspensionReason      String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  wholesaler            User        @relation(fields: [wholesalerId], references: [id], onDelete: Cascade)
  product               Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]
  ledgerEntries         ResellerCommissionLedgerEntry[]

  @@index([wholesalerId])
  @@index([productId])
  @@index([status])
}

model ResellerCommissionLedgerEntry {
  id                     String      @id @default(uuid())
  entryNumber            String      @unique // RLED-2026-00001
  wholesalerId           String
  listingId              String?
  orderId                String?
  orderItemId            String?
  statementId            String?
  entryType              String      // SALE_COMMISSION, RETURN_COMMISSION_REVERSAL, MANUAL_ADJUSTMENT, SETTLEMENT_PAYOUT
  quantity               Int         @default(1)
  wholesalerBaseAmount   Float       // Net owed to wholesaler (e.g. 500)
  platformCommissionRate Float       // e.g. 2.0%
  platformCommission     Float       // e.g. +10 on sale, -10 on return
  grossAmount            Float       // e.g. 510 on sale, -510 on return
  note                   String?
  createdAt              DateTime    @default(now())

  wholesaler             User                     @relation(fields: [wholesalerId], references: [id], onDelete: Cascade)
  listing                WholesalerPublicListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  statement              ResellerMonthlyStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([wholesalerId])
  @@index([listingId])
  @@index([statementId])
  @@index([entryType])
  @@index([createdAt])
}

model ResellerMonthlyStatement {
  id                     String      @id @default(uuid())
  statementNumber        String      @unique // STMT-2026-09-0001
  wholesalerId           String
  billingPeriodMonth     Int         // 1 - 12
  billingPeriodYear      Int         // 2026
  totalSalesCount        Int         @default(0)
  totalSoldUnits         Int         @default(0)
  grossSalesVolume       Float       @default(0)
  totalCommissionOwed    Float       @default(0)
  netWholesalerPayout    Float       @default(0)
  totalReturnsDeduction  Float       @default(0)
  commissionRefundAmount Float       @default(0)
  closingBalance         Float       @default(0)
  status                 String      @default("PENDING_RECONCILIATION") // PENDING_RECONCILIATION, ACKNOWLEDGED_PAID, DISPUTED, SETTLED
  wholesalerResponseAt   DateTime?
  wholesalerNote         String?
  adminSettlementNote    String?
  settledAt              DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  wholesaler             User        @relation(fields: [wholesalerId], references: [id], onDelete: Cascade)
  ledgerEntries          ResellerCommissionLedgerEntry[]

  @@unique([wholesalerId, billingPeriodYear, billingPeriodMonth])
  @@index([wholesalerId])
  @@index([status])
  @@index([billingPeriodYear, billingPeriodMonth])
}

// Phase 8: Gaming (Diamond Top-Ups & Game Voucher Recharge)
model Game {
  id                      String              @id @default(uuid())
  name                    String              // e.g. "Free Fire", "Mobile Legends", "PUBG Mobile"
  slug                    String              @unique
  publisher               String              // e.g. "Garena", "Moonton", "Tencent Games"
  category                String              @default("BATTLE_ROYALE") // BATTLE_ROYALE, MOBA, RPG, FPS, CASUAL
  imageUrl                String?
  bannerUrl               String?
  requiresZoneId          Boolean             @default(false)
  zoneIdLabel             String?             // e.g. "Zone ID (4-5 digits)"
  requiresServer          Boolean             @default(false)
  serverOptionsJson       String?             // JSON array e.g. ["Asia", "Europe", "America"]
  idFormatValidationRegex String?             // Regex string e.g. "^[0-9]{8,12}$"
  idInstructions          String?             // e.g. "Find your Player ID in Profile > Basic Info."
  fulfillmentMode         String              @default("AUTO_API") // AUTO_API, MANUAL_STAFF
  sortOrder               Int                 @default(0)
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  packages                GameTopUpPackage[]
  orders                  GameTopUpOrder[]

  @@index([slug])
  @@index([isActive])
}

model GameTopUpPackage {
  id           String           @id @default(uuid())
  gameId       String
  name         String           // e.g. "100 Diamonds + 10 Bonus", "Weekly Diamond Pass"
  diamondCount Int              // Primary diamonds / UC / VP count
  bonusCount   Int              @default(0)
  priceBdt     Float            // Price in BDT (e.g. 85.00)
  badgeText    String?          // e.g. "HOT", "BEST VALUE", "+10% BONUS"
  iconUrl      String?
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  game         Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  orders       GameTopUpOrder[]

  @@index([gameId])
  @@index([isActive])
}

model GameTopUpOrder {
  id                     String           @id @default(uuid())
  orderNumber            String           @unique // ORD-GAME-2026-00001
  userId                 String?
  guestEmail             String?
  guestPhone             String?
  gameId                 String
  packageId              String
  playerId               String
  zoneId                 String?
  serverRegion           String?
  playerNickname         String?          // Verified in-game name
  priceBdt               Float
  paymentMethod          String           // BKASH, NAGAD, CARD (strictly no COD)
  paymentStatus          String           @default("PAID")
  fulfillmentStatus      String           @default("DELIVERED") // PENDING, PROCESSING, DELIVERED, FAILED
  fulfillmentMode        String           @default("AUTO_API") // AUTO_API, MANUAL_STAFF
  providerTransactionRef String?          // Top-up provider / recharge API reference ID
  fulfilledByStaffId     String?
  fulfilledAt            DateTime?
  notes                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user                   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  game                   Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  package                GameTopUpPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gameId])
  @@index([packageId])
  @@index([fulfillmentStatus])
  @@index([orderNumber])
  @@index([createdAt])
}





