# ==============================================================================
# Siam's Aqua E-Commerce - Root Environment Template (.env.example)
# Copy this file to .env and configure values before starting development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL production/dev connection string:
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siamaqua_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Server & Authentication Security
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001/api"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:8081"
JWT_SECRET="replace-with-a-very-long-and-secure-random-secret-key-32-chars-min"
JWT_EXPIRATION="7d"

# ------------------------------------------------------------------------------
# 3. File Storage (S3 / Cloudflare R2 - Signed Expiring URLs)
# ------------------------------------------------------------------------------
# Supports Cloudflare R2, AWS S3, or MinIO for prescriptions, licenses, and docs
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_BUCKET_NAME="siamaqua-secure-assets"
S3_PUBLIC_URL="https://assets.siamaqua.com"
S3_SIGNED_URL_EXPIRY_SECONDS=3600

# ------------------------------------------------------------------------------
# 4. Payment Gateways (Bangladesh Payment Aggregator)
# ------------------------------------------------------------------------------
# Primary Aggregator: SSLCommerz (bKash, Nagad, Rocket, Cards, Internet Banking)
SSLCOMMERZ_STORE_ID="siamaquabd_live"
SSLCOMMERZ_STORE_PASSWORD="your-sslcommerz-store-password"
SSLCOMMERZ_IS_SANDBOX=true

# Alternative Aggregator: ShurjoPay
SHURJOPAY_MERCHANT_USERNAME="siamaqua_sp"
SHURJOPAY_MERCHANT_PASSWORD="your-shurjopay-password"
SHURJOPAY_API_ENDPOINT="https://sandbox.shurjopayment.com"

# ------------------------------------------------------------------------------
# 5. Push Notifications (Firebase Cloud Messaging - FCM)
# ------------------------------------------------------------------------------
FCM_PROJECT_ID="siams-aqua-ecommerce"
FCM_CLIENT_EMAIL="firebase-adminsdk@siams-aqua-ecommerce.iam.gserviceaccount.com"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 6. Bangladesh SMS Gateway (Specific provider configured upon decision)
# ------------------------------------------------------------------------------
BANGLADESH_SMS_GATEWAY_URL="https://api.sms-gateway-bd.com/v1/send"
BANGLADESH_SMS_API_KEY="your-bangladesh-sms-api-key"
BANGLADESH_SMS_SENDER_ID="SIAMAQUA"

# ------------------------------------------------------------------------------
# 7. Transactional Email (Resend / SendGrid)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
EMAIL_FROM="Siam's Aqua Orders <orders@siamaqua.com>"

# ------------------------------------------------------------------------------
# 8. Web Frontend (Next.js) Public Variables
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NEXT_PUBLIC_PLATFORM_NAME="Siam's Aqua E-Commerce"
